# Trivy Server Configuration

## Server
PORT=4954
TRIVY_LISTEN=0.0.0.0:4954

## Database / Cache
TRIVY_CACHE_BACKEND=fs
TRIVY_SKIP_DB_UPDATE=false
TRIVY_DB_REPOSITORY=mirror.gcr.io/aquasec/trivy-db:2

## Scanners
TRIVY_SCANNERS=vuln,misconfig,secret,license

## Authentication (optional - for private registry access)
# TRIVY_USERNAME=
# TRIVY_PASSWORD=
# TRIVY_REGISTRY_TOKEN=

## Proxy (optional)
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=
